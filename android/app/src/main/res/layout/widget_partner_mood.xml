<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161922"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Верхний блок статуса -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_avatar_emoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🐕"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_partner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="НАСТРОЕНИЕ ПАРТНЕРА"
                android:textColor="#FF6B6B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_mood_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="На волне радости!"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="только что • связь отличная"
                android:textColor="#8E93A3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Нижняя полоса быстрых действий One UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_widget_hug"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#22283A"
            android:text="🤗 Обнять"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_widget_on_way"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#22283A"
            android:text="🚗 Уже еду"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_widget_shopping"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#22283A"
            android:text="🛒 Покупки"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
